* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# A UTF-8 BOM before the shebang makes the kernel refuse to exec the
# script ("exec format error"), and a BOM at the top of a Dockerfile
# breaks the FROM parser. Guard the entrypoint and image config.
/docker/entrypoint.sh -text
Dockerfile -text
compose.yml -text

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
